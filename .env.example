# Copy to .env. Replace every CHANGE_ME value before running.
DATABASE_URL=postgresql+psycopg://smartrag:CHANGE_ME_DB_PASSWORD@postgres:5432/smartrag
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=smartrag-pro
JWT_AUDIENCE=smartrag-pro-api
ACCESS_TOKEN_MINUTES=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Required only when EMBEDDING_PROVIDER=openai; also change EMBEDDING_MODEL.
OPENAI_API_KEY=
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smartrag_google_768_v1
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://objectstore:8333
S3_ACCESS_KEY=smartrag
S3_SECRET_KEY=CHANGE_ME_STORAGE_PASSWORD
S3_BUCKET=smartrag-documents
S3_REGION=us-east-1
API_BASE_URL=http://api:8000
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=300
