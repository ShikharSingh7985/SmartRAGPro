# Copy to .env. Replace every CHANGE_ME value before running.
DATABASE_URL=postgresql+psycopg://smartrag:CHANGE_ME_DB_PASSWORD@postgres:5432/smartrag
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=smartrag-pro
JWT_AUDIENCE=smartrag-pro-api
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Local Compose: run python -m scripts.configure_security after configuring this file.
# It generates these random credentials and ignored role-specific environments.
MIGRATION_DATABASE_URL=
RUNTIME_DATABASE_PASSWORD=
WORKER_DATABASE_PASSWORD=
REDIS_PASSWORD=
QDRANT_READ_API_KEY=
SERVICE_ROLE=api
ALLOWED_HOSTS=["localhost","127.0.0.1","api","testserver"]
CORS_ORIGINS=[]
# Hosted deployments require TLS. Default local loopback development uses HTTP.
REQUIRE_HTTPS=false
MAX_DOCUMENTS_PER_USER=100
MAX_STORAGE_BYTES_PER_USER=524288000
MAX_ACTIVE_JOBS_PER_USER=3
MAX_DERIVED_BYTES_PER_DOCUMENT=268435456
MAX_PDF_OBJECTS=50000
MAX_PDF_IMAGE_PIXELS=20000000
MAX_PDF_STREAM_BYTES=268435456
MAX_PDF_EXPANSION_RATIO=200
SECURITY_BLOCK_THRESHOLD=80
SECURITY_AUDIT_RETENTION_DAYS=90
# Optional, operator-provisioned ClamAV. Enabled service failures fail ingestion closed.
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Required only when EMBEDDING_PROVIDER=openai; also change EMBEDDING_MODEL.
OPENAI_API_KEY=
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smartrag_google_768_v1
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://objectstore:8333
S3_ACCESS_KEY=smartrag
S3_SECRET_KEY=CHANGE_ME_STORAGE_PASSWORD
S3_BUCKET=smartrag-documents
S3_REGION=us-east-1
API_BASE_URL=http://api:8000
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=1000
PARSER_ENGINE=docling
# Optional predownloaded Docling artifacts; otherwise downloaded into worker model cache.
DOCLING_ARTIFACTS_PATH=
EXTRACTION_MODE=auto
OCR_BACKEND=tesseract
OCR_LANGUAGE=eng
TESSERACT_CMD=tesseract
OCR_TIMEOUT_SECONDS=60
RENDER_MAX_DIMENSION=1800
RENDER_DPI=150
MAX_FIGURES_PER_PAGE=8
VISION_ENABLED=false
VISION_MODEL=gemini-3.8-flash
MAX_VISION_CALLS=6
CHUNK_TOKENS=450
CHUNK_OVERLAP_TOKENS=50
EMBEDDING_BATCH_SIZE=16
EMBEDDING_VERSION=v1
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INGESTION_TIMEOUT_SECONDS=3600
INGESTION_MAX_ATTEMPTS=3
PAGE_TIMEOUT_SECONDS=180
MAX_EXTRACTED_CHARACTERS=20000000
# Finite conversational input budgets (cl100k estimates, not Gemini billing tokens).
CHAT_CONTEXT_TOKENS=10000
CHAT_HISTORY_TOKENS=1800
CHAT_SUMMARY_TOKENS=800
CHAT_EVIDENCE_TOKENS=4000
CHAT_RECENT_MESSAGES=12
CHAT_RECALL_MESSAGES=6
CHAT_SUMMARY_BATCH=100
# Optional paid follow-up rewrite; standalone queries never need an extra model call.
CHAT_LLM_REWRITE=false
CHAT_QUERY_MODEL=
ENVIRONMENT=production
# Local DEBUG query logging only; leave disabled for private user conversations.
CHAT_TRACE_QUERIES=false
# Validation retained dense as default; hybrid/rerank remain explicit experiments.
RETRIEVAL_MODE=dense
RETRIEVAL_CANDIDATES=24
# Lexical / dense rank-fusion share; .7 means 70% lexical, 30% dense.
RETRIEVAL_LEXICAL_WEIGHT=0.5
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_CANDIDATES=24
RETRIEVAL_DEDUPLICATE=false
QUERY_EMBEDDING_CACHE_SIZE=128
QUERY_EMBEDDING_CACHE_TTL=300
