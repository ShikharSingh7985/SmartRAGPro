{
  "uid": "smartrag-operations",
  "title": "SmartRAG Pro operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "smartrag"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(smartrag_http_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(smartrag_http_requests_total{status=~\"5..\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "API p50",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50,sum by(le)(rate(smartrag_http_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "API p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(smartrag_http_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "API p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99,sum by(le)(rate(smartrag_http_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Authentication failures / rate limits",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by(status)(increase(smartrag_http_requests_total{status=~\"401|429\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "smartrag_http_active",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "RAG stage p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,operation)(rate(smartrag_operation_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Provider tokens",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "sum by(direction)(increase(smartrag_llm_tokens_total[1h]))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Estimated model cost (configured prices)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "increase(smartrag_llm_estimated_usd_total[1h]) and on() (smartrag_cost_configured == 1)",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
    {
