      "targets": [
        {
          "expr": "sum by(outcome)(increase(smartrag_events_total{operation=\"guardrail.inspection\"}[1h]))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
