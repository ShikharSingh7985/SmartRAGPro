        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "sum(rate(smartrag_events_total{operation=\"embedding.cache\",outcome=\"hit\"}[5m])) / sum(rate(smartrag_events_total{operation=\"embedding.cache\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{operation}}{{outcome}}{{job}}{{status}}{{method}}{{direction}}{{kind}}{{service}}{{dependency}}"
        }
      ]
    },
